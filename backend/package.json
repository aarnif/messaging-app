{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:start": "docker compose -f docker-compose.yml up",
    "db:populate": "POPULATE_DB=true tsx src/populateDatabase.ts",
    "generate": "graphql-codegen --config codegen.ts",
    "dev": "npm run generate && NODE_ENV=development nodemon --exec tsx src/index.ts",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 src/tests/*.test.ts",
    "test:coverage": "NODE_ENV=test c8 --reporter=clover --reporter=html --reporter=json --reporter=text --reports-dir=coverage tsx --test --test-concurrency=1 src/tests/*.test.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "prod": "npm run generate && NODE_ENV=production tsx src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-resolvers": "^5.1.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^6.0.3",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  }
}
